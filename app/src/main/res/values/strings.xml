    <string name="login_help_title">Router admin password</string>
    <string name="login_help_which">This is the password for the router\'s settings page. It\'s usually different from the password you use to join the Wi-Fi.</string>
    <string name="login_help_where">Look on the sticker on the router. If your internet provider installed it, they can tell you the password.</string>
    <string name="login_help_openwrt">OpenWrt: the user is root. A new router has no password until someone sets one.</string>
    <string name="login_help_tenda">Tenda: the password is often empty or admin, unless someone changed it.</string>
    <string name="login_help_tplink">TP-Link: older models often use admin for both. Newer ones ask you to create a password during setup.</string>
    <string name="login_help_reset">Factory reset is the last resort. It erases your Wi-Fi name, password and internet settings, so every device has to reconnect and you may need details from your provider.</string>
