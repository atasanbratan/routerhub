<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Package visibility (Android 11+): extensions are discovered by scanning installed packages
        for the dev.routerhub.extension feature, the same model Mihon uses. Fine for F-Droid and
        GitHub releases; Google Play doesn't allow it, which is why the play flavor builds the
        extensions in instead and has no such permission.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Browse installs extensions from the repositories by handing their APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The extension gear's Uninstall, which asks the system to remove an extension package. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <application>
        <!-- Shares a downloaded extension APK with the system installer, and nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.extensions"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/extension_apks" />
        </provider>
    </application>
</manifest>
